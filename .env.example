# Copy this file to ".env" and adjust values if needed.
# All paths are resolved relative to the directory you run commands from
# (normally the project root).

# Raw CSV with columns: url,label (1 = phishing, 0 = legitimate)
PHISHING_DATASET_PATH=data/raw/urls.csv

# Where the selected model bundle is written / read
PHISHING_MODEL_PATH=models/phishing_detector.joblib

# Reproducibility
PHISHING_RANDOM_STATE=42
PHISHING_TEST_SIZE=0.2
